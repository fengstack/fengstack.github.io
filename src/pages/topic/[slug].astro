---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOPICS, type Topic } from '../../data/topics';
import { Layers, ArrowLeft } from 'lucide-astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts', ({ data }) => !data.draft);

  return TOPICS.map((topic) => {
    const posts = allPosts
      .filter((p) => topic.postSlugs.includes(p.slug))
      .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

    return {
      params: { slug: topic.slug },
      props: { topic, posts },
    };
  });
}

interface Props {
  topic: Topic;
  posts: CollectionEntry<'posts'>[];
}

const { topic, posts } = Astro.props;

const pageTitle = `${topic.name} · 技术专题精选 · 高云峰的博客`;
const pageDescription = `${topic.description} 本专题精选收录高云峰关于 ${topic.name} 的深度原理剖析、架构演进与实战复盘。`;

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '技术专题', url: '/topic/' },
  { name: topic.name, url: `/topic/${topic.slug}/` },
];

const canonicalURL = new URL(`/topic/${topic.slug}/`, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  'name': pageTitle,
  'description': pageDescription,
  'url': canonicalURL.toString(),
  'mainEntity': {
    '@type': 'ItemList',
    'itemListElement': posts.map((post, index) => ({
      '@type': 'ListItem',
      'position': index + 1,
      'url': new URL(`/post/${post.slug}/`, Astro.site).toString(),
      'name': post.data.title,
    })),
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  canonicalURL={canonicalURL}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="wrap-container py-12">
    <!-- Breadcrumbs -->
    <nav class="mb-6 flex items-center gap-2 text-xs font-mono text-muted" aria-label="面包屑导航">
      <a href="/" class="hover:text-fg transition-colors">首页</a>
      <span class="text-line">/</span>
      <a href="/topic/" class="hover:text-fg transition-colors">技术专题</a>
      <span class="text-line">/</span>
      <span class="text-fg">{topic.name}</span>
    </nav>

    <!-- Header -->
    <header class="border-b border-line pb-8">
      <div class="inline-flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-wider text-accent mb-2">
        <Layers class="h-4 w-4" />
        <span>{topic.subtitle}</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl font-bold tracking-tight text-fg">
        {topic.name}
      </h1>

      <p class="mt-3 text-sm sm:text-base text-muted leading-relaxed max-w-3xl">
        {topic.description}
      </p>

      <div class="mt-4 flex items-center gap-4 text-xs font-mono text-muted">
        <span>已收录 {posts.length} 篇深度技术分析</span>
      </div>
    </header>

    <!-- Articles List -->
    <div class="mt-10">
      <ul class="divide-y divide-line/60">
        {posts.map((post) => {
          const dateStr = post.data.publishDate.toISOString().slice(0, 10);
          return (
            <li class="py-7 first:pt-0 last:pb-0">
              <article class="flex flex-col gap-2">
                <div class="flex items-center gap-3 text-xs font-mono text-muted">
                  <time datetime={dateStr}>{dateStr}</time>
                  {post.data.readTime && <span>· {post.data.readTime}</span>}
                  {post.data.series && (
                    <span class="rounded bg-accent/10 px-1.5 py-0.5 text-accent font-sans text-[11px]">
                      {post.data.series.name}
                    </span>
                  )}
                </div>

                <h2 class="font-serif text-lg sm:text-xl font-bold leading-snug text-fg hover:text-accent transition-colors">
                  <a href={`/post/${post.slug}/`}>
                    {post.data.title}
                  </a>
                </h2>

                <p class="text-sm text-muted line-clamp-3 leading-relaxed">
                  {post.data.description}
                </p>

                <div class="mt-2 flex flex-wrap items-center gap-1.5">
                  {post.data.tags.map((t) => (
                    <span class="rounded bg-surface px-2 py-0.5 text-xs text-muted font-mono">
                      {t}
                    </span>
                  ))}
                </div>
              </article>
            </li>
          );
        })}
      </ul>
    </div>

    <!-- Back to Topics -->
    <div class="mt-12 border-t border-line pt-6">
      <a
        href="/topic/"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-accent hover:underline"
      >
        <ArrowLeft class="h-3.5 w-3.5" />
        <span>查看全部技术专题</span>
      </a>
    </div>
  </div>
</BaseLayout>
