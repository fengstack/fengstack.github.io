---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Search } from 'lucide-astro';

const posts = await getCollection('posts');
const sortedPosts = posts.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

// Collect all unique tags and counts
const tagCounts = new Map<string, number>();
sortedPosts.forEach((p) => {
  p.data.tags.forEach((t) => {
    tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
  });
});

const allTags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1]);
---

<BaseLayout
  title="技术文章与开源博客 · 高云峰"
  description="高云峰的技术文章与开源博客列表：专注 Java RPC 框架治理、分布式系统与事务（simple-seata）、AI Agent 规范驱动编程实践（SDD/TDD）、数据库与开源实战。"
>
  <div class="wrap-container py-12">
    <!-- Header -->
    <div class="border-b border-line pb-8">
      <h1 class="font-serif text-3xl sm:text-4xl font-bold tracking-tight text-fg">
        技术文章 · 高云峰
      </h1>
      <p class="mt-2 text-sm font-mono text-muted">
        posts · 分布式系统、RPC 治理、开源实战与现代 AI Agent 编程实践
      </p>

      <!-- Search & Tags bar -->
      <div class="mt-8 flex flex-col gap-4">
        <!-- Search Input -->
        <div class="relative">
          <Search class="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-muted pointer-events-none" />
          <input
            id="listSearchInput"
            type="search"
            placeholder="在当前列表中筛选文章标题、摘要或标签…"
            class="w-full rounded-md border border-line bg-surface/50 pl-10 pr-4 py-2.5 text-sm text-fg placeholder:text-muted transition-colors focus:border-accent focus:bg-surface focus:outline-none"
            autocomplete="off"
          />
        </div>

        <!-- Tag filter pills -->
        <div class="flex flex-wrap items-center gap-2 pt-1" id="tagFilterContainer">
          <button
            type="button"
            class="tag-pill active rounded-md border border-line bg-surface px-2.5 py-1 text-xs font-mono text-fg transition-all hover:border-accent"
            data-tag="all"
          >
            全部 ({sortedPosts.length})
          </button>
          {allTags.map(([tag, count]) => (
            <button
              type="button"
              class="tag-pill rounded-md border border-line bg-surface/40 px-2.5 py-1 text-xs font-mono text-muted transition-all hover:border-accent hover:text-fg"
              data-tag={tag}
            >
              {tag} <span class="text-[10px] opacity-75">({count})</span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Article Timeline List -->
    <div class="mt-10">
      <div id="noMatchMessage" class="hidden py-16 text-center text-sm text-muted">
        未找到匹配筛选条件的技术文章。
      </div>

      <ul class="divide-y divide-line/60" id="postsTimeline">
        {sortedPosts.map((post) => {
          const dateStr = post.data.publishDate.toISOString().slice(0, 10);
          return (
            <li
              class="post-item py-7 first:pt-0 last:pb-0 transition-opacity"
              data-title={post.data.title.toLowerCase()}
              data-desc={post.data.description.toLowerCase()}
              data-tags={post.data.tags.join(',').toLowerCase()}
            >
              <div class="flex flex-col gap-2">
                <div class="flex items-center gap-3 text-xs font-mono text-muted">
                  <time datetime={dateStr}>{dateStr}</time>
                  {post.data.readTime && <span>· {post.data.readTime}</span>}
                  {post.data.series && (
                    <span class="rounded bg-accent/10 px-1.5 py-0.5 text-accent font-sans text-[11px]">
                      {post.data.series.name}
                    </span>
                  )}
                </div>

                <h2 class="font-serif text-lg sm:text-xl font-bold leading-snug text-fg hover:text-accent transition-colors">
                  <a href={`/post/${post.slug}/`}>
                    {post.data.title}
                  </a>
                </h2>

                <p class="text-sm text-muted line-clamp-3 leading-relaxed">
                  {post.data.description}
                </p>

                <div class="mt-2 flex flex-wrap items-center gap-1.5">
                  {post.data.tags.map((t) => (
                    <span class="rounded bg-surface px-2 py-0.5 text-xs text-muted font-mono">
                      {t}
                    </span>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</BaseLayout>

<script>
  let activeTag = 'all';
  const searchInput = document.getElementById('listSearchInput') as HTMLInputElement | null;
  const tagPills = document.querySelectorAll<HTMLButtonElement>('.tag-pill');
  const postItems = document.querySelectorAll<HTMLElement>('.post-item');
  const noMatchMsg = document.getElementById('noMatchMessage');

  function filterPosts() {
    const q = searchInput?.value.trim().toLowerCase() || '';
    let visibleCount = 0;

    postItems.forEach((item) => {
      const title = item.dataset.title || '';
      const desc = item.dataset.desc || '';
      const tags = item.dataset.tags || '';

      const matchesSearch = !q || title.includes(q) || desc.includes(q) || tags.includes(q);
      const matchesTag = activeTag === 'all' || tags.split(',').includes(activeTag.toLowerCase());

      if (matchesSearch && matchesTag) {
        item.classList.remove('hidden');
        visibleCount++;
      } else {
        item.classList.add('hidden');
      }
    });

    if (visibleCount === 0) {
      noMatchMsg?.classList.remove('hidden');
    } else {
      noMatchMsg?.classList.add('hidden');
    }
  }

  // Tag button clicks
  tagPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      tagPills.forEach((p) => {
        p.classList.remove('active', 'text-fg', 'bg-surface');
        p.classList.add('text-muted', 'bg-surface/40');
      });

      pill.classList.add('active', 'text-fg', 'bg-surface');
      pill.classList.remove('text-muted', 'bg-surface/40');

      activeTag = pill.dataset.tag || 'all';
      filterPosts();
    });
  });

  searchInput?.addEventListener('input', filterPosts);
</script>
