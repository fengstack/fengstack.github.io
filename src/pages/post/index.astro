---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOPICS } from '../../data/topics';
import { SITE } from '../../data/site';
import { getPublishedPosts } from '../../utils/posts';
import { Search, Layers } from 'lucide-astro';

const sortedPosts = await getPublishedPosts('desc');

// Collect all unique tags and counts
const tagCounts = new Map<string, number>();
sortedPosts.forEach((p) => {
  p.data.tags.forEach((t) => {
    tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
  });
});

const allTags = Array.from(tagCounts.entries()).sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-CN')
);
const highFreqCount = allTags.filter(([, count]) => count >= 2).length;
const visibleTagLimit = highFreqCount >= 12 ? highFreqCount : Math.min(allTags.length, 16);
const hasExtraTags = allTags.length > visibleTagLimit;

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '技术文章', url: '/post/' },
];
---

<BaseLayout
  title={`技术文章与开源博客 · ${SITE.name}`}
  description={`${SITE.name} 的技术文章与开源博客列表：专注 Java RPC 框架治理、分布式系统与事务（simple-seata）、AI Agent 规范驱动编程实践（SDD/TDD）、数据库与开源实战。`}
  breadcrumbs={breadcrumbs}
>
  <div class="wrap-container py-12">
    <!-- Breadcrumbs -->
    <nav class="mb-6 flex items-center gap-2 text-xs font-mono text-muted" aria-label="面包屑导航">
      <a href="/" class="hover:text-fg transition-colors">首页</a>
      <span class="text-line">/</span>
      <span class="text-fg">技术文章</span>
    </nav>

    <!-- Header -->
    <div class="border-b border-line pb-8">
      <h1 class="font-serif text-3xl sm:text-4xl font-bold tracking-tight text-fg">
        技术文章 · {SITE.name}
      </h1>
      <p class="mt-2 text-sm font-mono text-muted">
        posts · 分布式系统、RPC 治理、开源实战与现代 AI Agent 编程实践
      </p>

      <!-- Topic Shortcuts -->
      <div class="mt-5 flex flex-wrap items-center gap-2">
        <span class="text-xs font-mono text-muted flex items-center gap-1">
          <Layers class="h-3.5 w-3.5 text-accent" />
          <span>核心专题：</span>
        </span>
        {TOPICS.map((topic) => (
          <a
            href={`/topic/${topic.slug}/`}
            class="rounded-md border border-line bg-surface/50 px-2.5 py-1 text-xs font-mono text-muted hover:border-accent hover:text-fg transition-all"
          >
            {topic.name}
          </a>
        ))}
      </div>

      <!-- Search & Tags bar -->
      <div class="mt-6 flex flex-col gap-4">
        <!-- Search Input -->
        <div class="relative">
          <Search class="absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-muted pointer-events-none" />
          <input
            id="listSearchInput"
            type="search"
            placeholder="在当前列表中筛选文章标题、摘要或标签…"
            class="w-full rounded-md border border-line bg-surface/50 pl-10 pr-4 py-2.5 text-sm text-fg placeholder:text-muted transition-colors focus:border-accent focus:bg-surface focus:outline-none"
            autocomplete="off"
          />
        </div>

        <!-- Tag filter pills -->
        <div class="flex flex-wrap items-center gap-2 pt-1" id="tagFilterContainer">
          <button
            type="button"
            class="tag-pill active rounded-md border border-accent bg-accent/10 px-2.5 py-1 text-xs font-mono font-semibold text-accent transition-all hover:border-accent"
            data-tag="all"
          >
            全部 ({sortedPosts.length})
          </button>
          {allTags.map(([tag, count], idx) => (
            <button
              type="button"
              class={`tag-pill rounded-md border border-line bg-tag-bg/60 px-2.5 py-1 text-xs font-mono text-tag-fg transition-all hover:border-accent hover:text-fg${idx >= visibleTagLimit ? ' hidden extra-tag-pill' : ''}`}
              data-tag={tag}
            >
              {tag} <span class="text-[10px] opacity-75">({count})</span>
            </button>
          ))}
          {hasExtraTags && (
            <button
              id="toggleExtraTagsBtn"
              type="button"
              aria-expanded="false"
              data-total-tags={allTags.length}
              class="rounded-md border border-dashed border-line bg-transparent px-2.5 py-1 text-xs font-mono text-accent transition-all hover:border-accent hover:bg-surface/40"
            >
              展开全部标签 ({allTags.length})
            </button>
          )}
        </div>

        <!-- Active Filter Status Bar -->
        <div id="filterStatusBar" class="hidden flex flex-wrap items-center justify-between gap-2 rounded-md border border-line bg-surface/40 px-3 py-2 text-xs font-mono text-muted">
          <span id="filterStatusText"></span>
          <button
            id="resetFiltersBtn"
            type="button"
            class="text-accent hover:underline"
          >
            重置筛选
          </button>
        </div>
      </div>
    </div>

    <!-- Article Timeline List -->
    <div class="mt-10">
      <div id="noMatchMessage" class="hidden py-16 text-center text-sm text-muted">
        未找到匹配筛选条件的技术文章。
      </div>

      <ul class="divide-y divide-line/60" id="postsTimeline">
        {sortedPosts.map((post) => {
          const dateStr = post.data.publishDate.toISOString().slice(0, 10);
          return (
            <li
              class="post-item py-7 first:pt-0 last:pb-0 transition-opacity"
              data-title={post.data.title.toLowerCase()}
              data-desc={post.data.description.toLowerCase()}
              data-tags={post.data.tags.join(',').toLowerCase()}
            >
              <div class="flex flex-col gap-2">
                <div class="flex items-center gap-3 text-xs font-mono text-muted">
                  <time datetime={dateStr}>{dateStr}</time>
                  {post.data.readTime && <span>· {post.data.readTime}</span>}
                  {post.data.series && (
                    <span class="rounded bg-accent/10 px-1.5 py-0.5 text-accent font-sans text-[11px]">
                      {post.data.series.name}
                    </span>
                  )}
                </div>

                <h2 class="font-serif text-lg sm:text-xl font-bold leading-snug text-fg hover:text-accent transition-colors">
                  <a href={`/post/${post.slug}/`}>
                    {post.data.title}
                  </a>
                </h2>

                <p class="text-sm text-muted line-clamp-3 leading-relaxed">
                  {post.data.description}
                </p>

                <div class="mt-2 flex flex-wrap items-center gap-1.5">
                  {post.data.tags.map((t) => (
                    <a
                      href={`/post/?tag=${encodeURIComponent(t)}`}
                      data-inline-tag={t}
                      class="inline-tag-link rounded border border-transparent bg-tag-bg px-2 py-0.5 text-xs text-tag-fg font-mono hover:border-accent hover:text-accent transition-colors"
                    >
                      {t}
                    </a>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</BaseLayout>

<script>
  let activeTag = 'all';
  let extraTagsExpanded = false;

  const searchInput = document.getElementById('listSearchInput') as HTMLInputElement | null;
  const tagFilterContainer = document.getElementById('tagFilterContainer');
  const tagPills = document.querySelectorAll<HTMLButtonElement>('.tag-pill');
  const postItems = document.querySelectorAll<HTMLElement>('.post-item');
  const noMatchMsg = document.getElementById('noMatchMessage');
  const filterStatusBar = document.getElementById('filterStatusBar');
  const filterStatusText = document.getElementById('filterStatusText');
  const resetFiltersBtn = document.getElementById('resetFiltersBtn');
  const toggleExtraTagsBtn = document.getElementById('toggleExtraTagsBtn') as HTMLButtonElement | null;
  const extraTagPills = document.querySelectorAll<HTMLButtonElement>('.extra-tag-pill');

  function setExtraTagsExpanded(expanded: boolean) {
    extraTagsExpanded = expanded;
    extraTagPills.forEach((pill) => {
      pill.classList.toggle('hidden', !extraTagsExpanded);
    });
    if (toggleExtraTagsBtn) {
      toggleExtraTagsBtn.setAttribute('aria-expanded', String(extraTagsExpanded));
      const totalTags = toggleExtraTagsBtn.dataset.totalTags || String(tagPills.length - 1);
      toggleExtraTagsBtn.textContent = extraTagsExpanded
        ? '收起低频标签'
        : `展开全部标签 (${totalTags})`;
    }
  }

  function syncUrlState() {
    const url = new URL(window.location.href);
    const q = searchInput?.value.trim() || '';

    if (activeTag !== 'all') {
      url.searchParams.set('tag', activeTag);
    } else {
      url.searchParams.delete('tag');
    }

    if (q) {
      url.searchParams.set('q', q);
    } else {
      url.searchParams.delete('q');
    }

    window.history.replaceState(null, '', url.pathname + url.search + url.hash);
  }

  function updatePillStyles(selectedTag: string) {
    tagPills.forEach((pill) => {
      const isSelected = (pill.dataset.tag || 'all').toLowerCase() === selectedTag.toLowerCase();
      if (isSelected) {
        pill.classList.add('active', 'border-accent', 'bg-accent/10', 'text-accent', 'font-semibold');
        pill.classList.remove('border-line', 'bg-tag-bg/60', 'text-tag-fg');
      } else {
        pill.classList.remove('active', 'border-accent', 'bg-accent/10', 'text-accent', 'font-semibold');
        pill.classList.add('border-line', 'bg-tag-bg/60', 'text-tag-fg');
      }
    });
  }

  function filterPosts(syncUrl = true) {
    const rawQuery = searchInput?.value.trim() || '';
    const q = rawQuery.toLowerCase();
    let visibleCount = 0;

    postItems.forEach((item) => {
      const title = item.dataset.title || '';
      const desc = item.dataset.desc || '';
      const tags = item.dataset.tags || '';

      const matchesSearch = !q || title.includes(q) || desc.includes(q) || tags.includes(q);
      const matchesTag = activeTag === 'all' || tags.split(',').includes(activeTag.toLowerCase());

      if (matchesSearch && matchesTag) {
        item.classList.remove('hidden');
        visibleCount++;
      } else {
        item.classList.add('hidden');
      }
    });

    if (visibleCount === 0) {
      noMatchMsg?.classList.remove('hidden');
    } else {
      noMatchMsg?.classList.add('hidden');
    }

    const hasFilter = activeTag !== 'all' || Boolean(q);
    if (filterStatusBar && filterStatusText) {
      if (hasFilter) {
        const parts: string[] = [];
        if (activeTag !== 'all') parts.push(`标签「${activeTag}」`);
        if (rawQuery) parts.push(`关键词「${rawQuery}」`);
        filterStatusText.textContent = `当前筛选：${parts.join(' + ')} · 共 ${visibleCount} 篇`;
        filterStatusBar.classList.remove('hidden');
      } else {
        filterStatusBar.classList.add('hidden');
      }
    }

    if (syncUrl) {
      syncUrlState();
    }
  }

  function selectTag(rawTag: string, syncUrl = true) {
    const normalized = rawTag.trim().toLowerCase();
    const matchedPill = Array.from(tagPills).find(
      (p) => (p.dataset.tag || 'all').toLowerCase() === normalized
    );

    activeTag = matchedPill?.dataset.tag || 'all';
    if (matchedPill?.classList.contains('extra-tag-pill') && !extraTagsExpanded) {
      setExtraTagsExpanded(true);
    }

    updatePillStyles(activeTag);
    filterPosts(syncUrl);
  }

  // Tag pill clicks
  tagPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      selectTag(pill.dataset.tag || 'all');
    });
  });

  // Inline post tag clicks
  document.querySelectorAll<HTMLAnchorElement>('.inline-tag-link').forEach((link) => {
    link.addEventListener('click', (e) => {
      const targetTag = link.dataset.inlineTag;
      if (!targetTag) return;
      e.preventDefault();
      selectTag(targetTag);
      tagFilterContainer?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });

  searchInput?.addEventListener('input', () => filterPosts(true));

  toggleExtraTagsBtn?.addEventListener('click', () => {
    setExtraTagsExpanded(!extraTagsExpanded);
  });

  resetFiltersBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    selectTag('all');
  });

  // Hydrate initial filter state from URL query (?tag=...&q=...)
  const initialParams = new URLSearchParams(window.location.search);
  const initialQuery = initialParams.get('q');
  const initialTag = initialParams.get('tag');
  if (initialQuery && searchInput) {
    searchInput.value = initialQuery;
  }
  if (initialTag) {
    selectTag(initialTag, false);
  } else if (initialQuery) {
    filterPosts(false);
  }
</script>
