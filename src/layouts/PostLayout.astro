---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SeriesBox from '../components/SeriesBox.astro';
import { SITE } from '../data/site';
import { getPublishedPosts, getPrimaryTopic, getPostTopics, type PostEntry } from '../utils/posts';
import { Calendar, Clock, Tag, ExternalLink, ArrowLeft, ArrowRight, ChevronUp, AlignLeft, ChevronDown, Sparkles, Layers } from 'lucide-astro';

interface Props {
  post: PostEntry;
  headings: MarkdownHeading[];
  prevPost?: PostEntry;
  nextPost?: PostEntry;
}

const { post, headings, prevPost, nextPost } = Astro.props;
const { title, description, publishDate, updatedDate, tags, readTime, series, refLink } = post.data;

const formattedDate = publishDate.toISOString().slice(0, 10);
const formattedUpdatedDate = updatedDate ? updatedDate.toISOString().slice(0, 10) : undefined;

// Topics: primary topic (most specific) and all belonging topics
const postTopics = getPostTopics(post.slug);
const primaryTopic = getPrimaryTopic(post.slug);
const postTopicSlugs = new Set(postTopics.map((t) => t.slug));

// Structured Breadcrumbs
const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '技术文章', url: '/post/' },
  ...(primaryTopic ? [{ name: primaryTopic.name, url: `/topic/${primaryTopic.slug}/` }] : []),
  { name: title, url: `/post/${post.slug}/` },
];

// Related posts calculation (series + shared tags + all belonging topics)
const allPosts = await getPublishedPosts('desc');
const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug)
  .map((p) => {
    let score = 0;
    if (series && p.data.series?.name === series.name) {
      score += 5;
    }
    const sharedTags = p.data.tags.filter((t) => tags.includes(t));
    score += sharedTags.length * 2;
    const candidateTopics = getPostTopics(p.slug);
    const sharedTopicsCount = candidateTopics.filter((t) => postTopicSlugs.has(t.slug)).length;
    if (sharedTopicsCount > 0) {
      score += sharedTopicsCount * 3;
    }
    if (primaryTopic && primaryTopic.postSlugs.includes(p.slug)) {
      score += 1;
    }
    return { post: p, score };
  })
  .filter((item) => item.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map((item) => item.post);
---

<BaseLayout
  title={`${title} · ${SITE.siteName}`}
  cleanTitle={title}
  description={description}
  type="article"
  publishDate={publishDate}
  updatedDate={updatedDate}
  articleTags={tags}
  breadcrumbs={breadcrumbs}
>
  <div class="w-full max-w-[1240px] mx-auto px-6 sm:px-8 lg:px-12 py-8 sm:py-12">
    <!-- Breadcrumbs -->
    <nav class="mb-6 flex flex-wrap items-center gap-2 text-xs font-mono text-muted" aria-label="面包屑导航">
      <a href="/" class="hover:text-fg transition-colors">首页</a>
      <span class="text-line">/</span>
      <a href="/post/" class="hover:text-fg transition-colors">文章</a>
      {primaryTopic && (
        <>
          <span class="text-line">/</span>
          <a href={`/topic/${primaryTopic.slug}/`} class="hover:text-fg transition-colors text-accent">
            {primaryTopic.name}
          </a>
        </>
      )}
      <span class="text-line">/</span>
      <span class="text-fg truncate max-w-[200px] sm:max-w-xs md:max-w-md" title={title}>{title}</span>
    </nav>

    <!-- Article Header -->
    <header class="border-b border-line pb-8 mb-10">
      <h1 class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold leading-tight tracking-tight text-fg max-w-4xl">
        {title}
      </h1>

      <div class="mt-4 flex flex-wrap items-center gap-y-2 gap-x-4 text-xs font-mono text-muted">
        <div class="flex items-center gap-1.5">
          <Calendar class="h-3.5 w-3.5" />
          <time datetime={formattedDate}>{formattedDate}</time>
          {formattedUpdatedDate && formattedUpdatedDate !== formattedDate && (
            <span class="text-[11px] opacity-75">（更新于 {formattedUpdatedDate}）</span>
          )}
        </div>

        {readTime && (
          <div class="flex items-center gap-1.5">
            <Clock class="h-3.5 w-3.5" />
            <span>{readTime}</span>
          </div>
        )}

        {postTopics.length > 0 && (
          <div class="flex items-center gap-1.5 flex-wrap">
            <Layers class="h-3.5 w-3.5 text-accent shrink-0" />
            {postTopics.map((topic) => (
              <a
                href={`/topic/${topic.slug}/`}
                class="rounded border border-accent/30 bg-accent/10 px-2 py-0.5 text-accent hover:bg-accent/15 hover:underline transition-colors"
              >
                {topic.name}
              </a>
            ))}
          </div>
        )}

        {tags.length > 0 && (
          <div class="flex items-center gap-1.5 flex-wrap">
            <Tag class="h-3.5 w-3.5" />
            {tags.map((tag) => (
              <a
                href={`/post/?tag=${encodeURIComponent(tag)}`}
                class="rounded border border-transparent bg-tag-bg px-2 py-0.5 text-tag-fg hover:border-accent hover:text-accent transition-colors"
              >
                {tag}
              </a>
            ))}
          </div>
        )}

        {refLink && (
          <div class="flex items-center gap-1">
            <a
              href={refLink.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1 text-accent hover:underline font-sans"
            >
              <span>{refLink.text}</span>
              <ExternalLink class="h-3 w-3" />
            </a>
          </div>
        )}
      </div>
    </header>

    <!-- Mobile Collapsible TOC (< 1024px) -->
    {headings.filter((h) => h.depth === 2 || h.depth === 3).length > 0 && (
      <details class="mobile-toc-details lg:hidden mb-8 rounded-lg border border-line bg-surface/50 p-4 transition-all">
        <summary class="flex items-center justify-between cursor-pointer font-serif text-sm font-semibold text-fg select-none list-none">
          <span class="flex items-center gap-2">
            <AlignLeft class="h-4 w-4 text-accent" />
            <span>文章目录 ({headings.filter((h) => h.depth === 2 || h.depth === 3).length} 节)</span>
          </span>
          <ChevronDown class="h-4 w-4 text-muted transition-transform duration-200 summary-chevron" />
        </summary>
        <div class="mt-4 pt-3 border-t border-line/60">
          <TableOfContents headings={headings} showTitle={false} />
        </div>
      </details>
    )}

    <!-- Content Grid: Article Prose + Sticky TOC -->
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_260px] gap-12 xl:gap-16 items-start">
      <!-- Article Content -->
      <article class="editorial-prose max-w-none min-w-0" id="articleBody">
        {series && <SeriesBox seriesName={series.name} currentSlug={post.slug} />}
        <slot />
      </article>

      <!-- Desktop Sidebar TOC -->
      <aside class="desktop-toc-aside hidden lg:block sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto">
        <TableOfContents headings={headings} />
      </aside>
    </div>

    <!-- Related Posts Section -->
    {relatedPosts.length > 0 && (
      <section class="mt-14 rounded-lg border border-line bg-surface/30 p-6" aria-label="相关技术文章推荐">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-5 pb-3 border-b border-line/60">
          <h2 class="font-serif text-base sm:text-lg font-bold text-fg flex items-center gap-2">
            <Sparkles class="h-4 w-4 text-accent" />
            <span>相关技术分析与延伸阅读</span>
          </h2>
          {primaryTopic && (
            <a
              href={`/topic/${primaryTopic.slug}/`}
              class="text-xs font-mono text-accent hover:underline flex items-center gap-1"
            >
              <span>查看「{primaryTopic.name}」专题全集</span>
              <ArrowRight class="h-3 w-3" />
            </a>
          )}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {relatedPosts.map((relPost) => (
            <a
              href={`/post/${relPost.slug}/`}
              class="group flex flex-col justify-between rounded-md border border-line/70 bg-surface/40 p-4 transition-all hover:border-accent hover:bg-surface"
            >
              <div>
                <div class="text-[11px] font-mono text-muted mb-1.5">
                  {relPost.data.publishDate.toISOString().slice(0, 10)}
                  {relPost.data.readTime && ` · ${relPost.data.readTime}`}
                </div>
                <h3 class="font-serif text-sm font-semibold text-fg group-hover:text-accent transition-colors line-clamp-2 leading-snug mb-2">
                  {relPost.data.title}
                </h3>
                <p class="text-xs text-muted line-clamp-2 leading-relaxed">
                  {relPost.data.description}
                </p>
              </div>
              <div class="mt-3 flex items-center gap-1 text-[11px] font-mono text-accent group-hover:underline">
                <span>阅读全文</span>
                <ArrowRight class="h-3 w-3 transition-transform group-hover:translate-x-0.5" />
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Prev & Next Article Navigation -->
    <nav class="mt-10 border-t border-line pt-7" aria-label="上一篇与下一篇文章">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {prevPost ? (
          <a
            href={`/post/${prevPost.slug}/`}
            rel="prev"
            class="group flex flex-col gap-1.5 border-l-2 border-line pl-4 py-1 transition-colors hover:border-accent"
          >
            <span class="flex items-center gap-1.5 text-xs font-mono text-muted group-hover:text-accent">
              <ArrowLeft class="h-3.5 w-3.5 transition-transform group-hover:-translate-x-0.5" />
              <span>上一篇</span>
              {series && prevPost.data.series?.name === series.name && (
                <span class="rounded bg-accent/10 px-1.5 py-0.5 text-[10px] font-sans text-accent">
                  同系列
                </span>
              )}
            </span>
            <span class="font-serif text-sm font-semibold text-fg group-hover:text-accent transition-colors line-clamp-2">
              {prevPost.data.title}
            </span>
          </a>
        ) : <div />}

        {nextPost ? (
          <a
            href={`/post/${nextPost.slug}/`}
            rel="next"
            class="group flex flex-col gap-1.5 sm:items-end text-left sm:text-right border-l-2 sm:border-l-0 sm:border-r-2 border-line pl-4 sm:pl-0 sm:pr-4 py-1 transition-colors hover:border-accent"
          >
            <span class="flex items-center gap-1.5 text-xs font-mono text-muted group-hover:text-accent">
              {series && nextPost.data.series?.name === series.name && (
                <span class="rounded bg-accent/10 px-1.5 py-0.5 text-[10px] font-sans text-accent">
                  同系列
                </span>
              )}
              <span>下一篇</span>
              <ArrowRight class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
            </span>
            <span class="font-serif text-sm font-semibold text-fg group-hover:text-accent transition-colors line-clamp-2">
              {nextPost.data.title}
            </span>
          </a>
        ) : <div />}
      </div>
    </nav>

    <!-- Back to top button -->
    <button
      id="backToTopBtn"
      type="button"
      class="fixed bottom-6 right-6 hidden z-30 rounded-full border border-line bg-bg/90 backdrop-blur-md p-3 text-muted shadow-md hover:text-fg hover:border-accent transition-all"
      aria-label="返回顶部"
    >
      <ChevronUp class="h-5 w-5" />
    </button>

    <!-- Lightbox dialog for images and Mermaid diagrams -->
    <dialog id="mediaLightbox" class="media-lightbox" aria-label="图片与图表放大预览">
      <div class="media-lightbox-shell">
        <div class="media-lightbox-topbar">
          <span id="mediaLightboxCaption" class="text-xs font-mono text-muted truncate"></span>
          <button
            id="mediaLightboxClose"
            type="button"
            class="rounded border border-line bg-bg px-2.5 py-1 text-xs font-mono text-muted hover:border-accent hover:text-fg transition-colors shrink-0"
            aria-label="关闭预览"
          >
            关闭 (ESC)
          </button>
        </div>
        <div id="mediaLightboxBody" class="media-lightbox-body"></div>
      </div>
    </dialog>
  </div>
</BaseLayout>

<script>
  // Close mobile TOC details when a link is clicked
  const mobileDetails = document.querySelector<HTMLDetailsElement>('.mobile-toc-details');
  mobileDetails?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      mobileDetails.open = false;
    });
  });

  // Add hover anchor links (#) to article headings
  document
    .querySelectorAll<HTMLElement>('#articleBody h2[id], #articleBody h3[id], #articleBody h4[id]')
    .forEach((heading) => {
      if (heading.querySelector('.heading-anchor')) return;
      const anchor = document.createElement('a');
      anchor.className = 'heading-anchor';
      anchor.href = `#${heading.id}`;
      anchor.setAttribute('aria-label', '复制本节链接');
      anchor.title = '点击定位并复制本节链接';
      anchor.textContent = '#';

      anchor.addEventListener('click', async () => {
        const shareUrl = `${window.location.origin}${window.location.pathname}#${heading.id}`;
        try {
          await navigator.clipboard.writeText(shareUrl);
          anchor.textContent = '✓';
          anchor.classList.add('is-copied');
          setTimeout(() => {
            anchor.textContent = '#';
            anchor.classList.remove('is-copied');
          }, 1500);
        } catch {
          // Allow native hash navigation without interrupting
        }
      });

      heading.appendChild(anchor);
    });

  // Media Lightbox dialog helpers
  const lightbox = document.getElementById('mediaLightbox') as HTMLDialogElement | null;
  const lightboxBody = document.getElementById('mediaLightboxBody');
  const lightboxCaption = document.getElementById('mediaLightboxCaption');
  const lightboxClose = document.getElementById('mediaLightboxClose');

  function openMediaLightbox(detail: {
    type: 'image' | 'mermaid';
    src?: string;
    alt?: string;
    svg?: string;
    caption?: string;
  }) {
    if (!lightbox || !lightboxBody || !lightboxCaption) return;
    lightboxBody.replaceChildren();

    if (detail.type === 'image' && detail.src) {
      lightbox.classList.remove('is-mermaid');
      const img = document.createElement('img');
      img.src = detail.src;
      img.alt = detail.alt || '';
      img.className = 'media-lightbox-img';
      lightboxBody.appendChild(img);
      lightboxCaption.textContent = detail.alt || '图片预览';
    } else if (detail.type === 'mermaid' && detail.svg) {
      lightbox.classList.add('is-mermaid');
      const svgWrap = document.createElement('div');
      svgWrap.className = 'media-lightbox-svg';
      svgWrap.innerHTML = detail.svg;
      const svgEl = svgWrap.querySelector('svg');
      if (svgEl) {
        svgEl.removeAttribute('height');
        svgEl.style.maxWidth = '100%';
        svgEl.style.maxHeight = '76vh';
        svgEl.style.width = '100%';
        svgEl.style.height = 'auto';
      }
      lightboxBody.appendChild(svgWrap);
      lightboxCaption.textContent = detail.caption || '架构流程图预览';
    }

    if (!lightbox.open) {
      lightbox.showModal();
    }
  }

  function closeMediaLightbox() {
    if (!lightbox || !lightbox.open) return;
    lightbox.close();
    lightbox.classList.remove('is-mermaid');
    lightboxBody?.replaceChildren();
  }

  lightboxClose?.addEventListener('click', closeMediaLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) {
      closeMediaLightbox();
    }
  });
  lightbox?.addEventListener('close', () => {
    lightbox.classList.remove('is-mermaid');
    lightboxBody?.replaceChildren();
  });

  window.addEventListener('media:open', (e) => {
    const customEvent = e as CustomEvent;
    if (customEvent.detail) {
      openMediaLightbox(customEvent.detail);
    }
  });

  // Wrap article images in figure/figcaption and enable lightbox zoom
  document.querySelectorAll<HTMLImageElement>('#articleBody img').forEach((img) => {
    if (img.closest('.mermaid-diagram') || img.closest('figure') || img.closest('a')) return;

    const figure = document.createElement('figure');
    figure.className = 'editorial-figure';
    img.parentNode?.insertBefore(figure, img);
    figure.appendChild(img);

    const altText = img.getAttribute('alt')?.trim() || '';
    if (altText) {
      const caption = document.createElement('figcaption');
      caption.className = 'editorial-figcaption';
      caption.textContent = altText;
      figure.appendChild(caption);
    }

    img.classList.add('cursor-zoom-in');
    img.setAttribute('tabindex', '0');
    img.setAttribute('role', 'button');
    img.setAttribute('aria-label', altText ? `放大查看图片：${altText}` : '放大查看图片');

    const openZoom = () => {
      openMediaLightbox({
        type: 'image',
        src: img.currentSrc || img.src,
        alt: altText,
      });
    };

    img.addEventListener('click', openZoom);
    img.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openZoom();
      }
    });
  });

  // Add unified header bar (language badge, conditional wide-view toggle, copy button) to code blocks
  const codePres = Array.from(document.querySelectorAll<HTMLElement>('.editorial-prose pre')).filter(
    (pre) => (pre.getAttribute('data-language') || '') !== 'mermaid'
  );

  if (codePres.length > 0) {
    const codeBackdrop = document.createElement('div');
    codeBackdrop.className = 'code-expand-backdrop hidden';
    document.body.appendChild(codeBackdrop);

    let activeExpanded: { wrapper: HTMLElement; btn: HTMLButtonElement } | null = null;
    const expandCheckers: Array<() => void> = [];

    const collapseExpanded = () => {
      if (!activeExpanded) return;
      activeExpanded.wrapper.classList.remove('is-expanded');
      activeExpanded.btn.textContent = '宽屏';
      activeExpanded.btn.setAttribute('aria-expanded', 'false');
      codeBackdrop.classList.add('hidden');
      document.body.style.overflow = '';
      const currentChecker = expandCheckers;
      activeExpanded = null;
      currentChecker.forEach((fn) => fn());
    };

    codeBackdrop.addEventListener('click', collapseExpanded);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && activeExpanded) {
        collapseExpanded();
      }
    });

    codePres.forEach((pre) => {
      const lang = pre.getAttribute('data-language') || '';
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrapper';

      const header = document.createElement('div');
      header.className = 'code-block-header';

      const badge = document.createElement('span');
      badge.className = 'code-action-badge';
      badge.textContent =
        lang === 'text' ? 'diagram · text' : lang && lang !== 'plaintext' ? lang : 'code';
      header.appendChild(badge);

      const actionsBar = document.createElement('div');
      actionsBar.className = 'code-block-actions';

      const expandBtn = document.createElement('button');
      expandBtn.className = 'code-expand-btn hidden';
      expandBtn.setAttribute('type', 'button');
      expandBtn.setAttribute('aria-expanded', 'false');
      expandBtn.setAttribute('aria-label', '切换代码块宽屏查看');
      expandBtn.textContent = '宽屏';

      const syncExpandBtn = () => {
        const isExpanded = wrapper.classList.contains('is-expanded');
        const hasOverflow = pre.scrollWidth > pre.clientWidth + 4;
        expandBtn.classList.toggle('hidden', !isExpanded && !hasOverflow);
      };

      expandBtn.addEventListener('click', () => {
        if (wrapper.classList.contains('is-expanded')) {
          collapseExpanded();
          return;
        }
        if (activeExpanded) {
          collapseExpanded();
        }
        wrapper.classList.add('is-expanded');
        expandBtn.textContent = '收起';
        expandBtn.setAttribute('aria-expanded', 'true');
        codeBackdrop.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        activeExpanded = { wrapper, btn: expandBtn };
      });

      const copyBtn = document.createElement('button');
      copyBtn.className = 'code-copy-btn';
      copyBtn.setAttribute('type', 'button');
      copyBtn.setAttribute('aria-label', '复制代码');
      copyBtn.textContent = '复制';

      copyBtn.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.innerText || pre.innerText;
        try {
          await navigator.clipboard.writeText(code);
          copyBtn.textContent = '已复制';
          copyBtn.classList.add('text-accent', 'border-accent');
          setTimeout(() => {
            copyBtn.textContent = '复制';
            copyBtn.classList.remove('text-accent', 'border-accent');
          }, 2000);
        } catch {
          copyBtn.textContent = '失败';
          setTimeout(() => {
            copyBtn.textContent = '复制';
          }, 2000);
        }
      });

      actionsBar.append(expandBtn, copyBtn);
      header.appendChild(actionsBar);

      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.append(header, pre);

      expandCheckers.push(syncExpandBtn);
      syncExpandBtn();
    });

    const syncAllExpandButtons = () => expandCheckers.forEach((fn) => fn());
    window.addEventListener('resize', syncAllExpandButtons, { passive: true });
    document.fonts?.ready.then(syncAllExpandButtons);
  }

  // Back to top scroll button
  const bttBtn = document.getElementById('backToTopBtn');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 400) {
      bttBtn?.classList.remove('hidden');
    } else {
      bttBtn?.classList.add('hidden');
    }
  });

  bttBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>

<!-- Mermaid diagram client-side dynamic rendering -->
<script is:inline type="module">
  (async function() {
    const mermaidPres = document.querySelectorAll('pre[data-language="mermaid"]');
    if (!mermaidPres.length) return;

    try {
      const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');

      function sanitizeMermaid(raw) {
        if (!raw) return '';
        // 1. Line-by-line: wrap unquoted edge labels after arrows/links (-->|...| etc.) with |"..."|
        //    so parentheses or slashes don't break Mermaid's parser without misparsing node names between quoted labels.
        let code = raw
          .split(/\r?\n/)
          .map((line) =>
            line.replace(
              /(--+>|==+>|-\.+->|---+|--+[xo]|<--+>|[xo]--+[xo])\s*\|([^"|\r\n][^|\r\n]*)\|/g,
              (match, arrow, label) => {
                const trimmed = label.trim();
                if (trimmed.startsWith('"') && trimmed.endsWith('"')) {
                  return match;
                }
                return `${arrow}|"${trimmed.replace(/"/g, '\\"')}"|`;
              }
            )
          )
          .join('\n');

        // 2. Escape non-br generic type angle brackets (including multi-arg, wildcards & nested generics)
        for (let pass = 0; pass < 5; pass++) {
          const next = code.replace(
            /<(?!\/?br\s*\/?)([A-Za-z_?](?:&lt;|&gt;|[\w \t,?.[\]])*)>/g,
            '&lt;$1&gt;'
          );
          if (next === code) break;
          code = next;
        }

        return code;
      }

      function initMermaid(theme) {
        mermaid.initialize({
          startOnLoad: false,
          theme: theme === 'dark' ? 'dark' : 'default',
          suppressErrorRendering: true,
          securityLevel: 'strict',
        });
      }

      let renderIdx = 0;
      let activeTheme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'default';
      initMermaid(activeTheme);

      const diagrams = [];

      for (let i = 0; i < mermaidPres.length; i++) {
        const pre = mermaidPres[i];
        const rawCode = pre.querySelector('code')?.textContent || pre.textContent || '';
        const graphDef = sanitizeMermaid(rawCode);
        const baseId = 'mermaid-' + i;
        const id = baseId + '-' + (++renderIdx);
        try {
          const { svg } = await mermaid.render(id, graphDef);
          const container = document.createElement('div');
          container.className = 'mermaid-diagram relative group my-8 p-4 rounded-xl border border-line bg-surface/30 shadow-sm';

          const zoomBtn = document.createElement('button');
          zoomBtn.type = 'button';
          zoomBtn.className = 'mermaid-zoom-btn';
          zoomBtn.textContent = '放大';
          zoomBtn.setAttribute('aria-label', '放大查看流程图');

          const svgWrap = document.createElement('div');
          svgWrap.className = 'mermaid-svg-wrap flex justify-center overflow-x-auto';
          svgWrap.innerHTML = svg;

          zoomBtn.addEventListener('click', () => {
            window.dispatchEvent(
              new CustomEvent('media:open', {
                detail: {
                  type: 'mermaid',
                  svg: svgWrap.innerHTML,
                  caption: '架构流程图预览',
                },
              })
            );
          });

          container.append(zoomBtn, svgWrap);
          pre.replaceWith(container);
          diagrams.push({ svgWrap, graphDef, baseId });
        } catch (e) {
          console.error('Mermaid render error:', e);
          pre.setAttribute('data-mermaid-error', 'true');
          document.getElementById('d' + id)?.remove();
        }
      }

      window.dispatchEvent(new Event('article:layout-change'));

      async function rerenderDiagrams() {
        for (const item of diagrams) {
          const id = item.baseId + '-' + (++renderIdx);
          try {
            const { svg } = await mermaid.render(id, item.graphDef);
            item.svgWrap.innerHTML = svg;
          } catch (e) {
            console.error('Mermaid re-render error:', e);
            document.getElementById('d' + id)?.remove();
          }
        }
      }

      if (diagrams.length > 0) {
        // Listen for data-theme change to re-render diagrams with matched theme
        const observer = new MutationObserver((mutations) => {
          for (const mutation of mutations) {
            if (mutation.type === 'attributes' && mutation.attributeName === 'data-theme') {
              const currentTheme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'default';
              if (currentTheme !== activeTheme) {
                activeTheme = currentTheme;
                initMermaid(currentTheme);
                rerenderDiagrams();
              }
            }
          }
        });
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      }
    } catch (err) {
      console.error('Failed to load Mermaid module:', err);
      mermaidPres.forEach((pre) => pre.setAttribute('data-mermaid-error', 'true'));
    }
  })();
</script>
