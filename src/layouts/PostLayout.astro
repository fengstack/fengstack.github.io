---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SeriesBox from '../components/SeriesBox.astro';
import { TOPICS } from '../data/topics';
import { Calendar, Clock, Tag, ExternalLink, ArrowLeft, ArrowRight, ChevronUp, AlignLeft, ChevronDown, Sparkles, Layers } from 'lucide-astro';

interface Props {
  post: CollectionEntry<'posts'>;
  headings: MarkdownHeading[];
  prevPost?: CollectionEntry<'posts'>;
  nextPost?: CollectionEntry<'posts'>;
}

const { post, headings, prevPost, nextPost } = Astro.props;
const { title, description, publishDate, updatedDate, tags, readTime, series, refLink } = post.data;

const formattedDate = publishDate.toISOString().slice(0, 10);
const formattedUpdatedDate = updatedDate ? updatedDate.toISOString().slice(0, 10) : undefined;

// Current topic
const currentTopic = TOPICS.find((t) => t.postSlugs.includes(post.slug));

// Structured Breadcrumbs
const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '技术文章', url: '/post/' },
  ...(currentTopic ? [{ name: currentTopic.name, url: `/topic/${currentTopic.slug}/` }] : []),
  { name: title, url: `/post/${post.slug}/` },
];

// Related posts calculation
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug)
  .map((p) => {
    let score = 0;
    if (series && p.data.series?.name === series.name) {
      score += 5;
    }
    const sharedTags = p.data.tags.filter((t) => tags.includes(t));
    score += sharedTags.length * 2;
    if (currentTopic && currentTopic.postSlugs.includes(p.slug)) {
      score += 3;
    }
    return { post: p, score };
  })
  .filter((item) => item.score > 0)
  .sort((a, b) => b.score - a.score || b.post.data.publishDate.getTime() - a.post.data.publishDate.getTime())
  .slice(0, 3)
  .map((item) => item.post);
---

<BaseLayout
  title={`${title} · 高云峰的博客`}
  cleanTitle={title}
  description={description}
  type="article"
  publishDate={publishDate}
  updatedDate={updatedDate}
  articleTags={tags}
  breadcrumbs={breadcrumbs}
>
  <div class="w-full max-w-[1240px] mx-auto px-6 sm:px-8 lg:px-12 py-8 sm:py-12">
    <!-- Breadcrumbs -->
    <nav class="mb-6 flex flex-wrap items-center gap-2 text-xs font-mono text-muted" aria-label="面包屑导航">
      <a href="/" class="hover:text-fg transition-colors">首页</a>
      <span class="text-line">/</span>
      <a href="/post/" class="hover:text-fg transition-colors">文章</a>
      {currentTopic && (
        <>
          <span class="text-line">/</span>
          <a href={`/topic/${currentTopic.slug}/`} class="hover:text-fg transition-colors text-accent">
            {currentTopic.name}
          </a>
        </>
      )}
      <span class="text-line">/</span>
      <span class="text-fg truncate max-w-[200px] sm:max-w-xs md:max-w-md" title={title}>{title}</span>
    </nav>

    <!-- Article Header -->
    <header class="border-b border-line pb-8 mb-10">
      <h1 class="font-serif text-2xl sm:text-3xl md:text-4xl font-bold leading-tight tracking-tight text-fg max-w-4xl">
        {title}
      </h1>

      <div class="mt-4 flex flex-wrap items-center gap-y-2 gap-x-4 text-xs font-mono text-muted">
        <div class="flex items-center gap-1.5">
          <Calendar class="h-3.5 w-3.5" />
          <time datetime={formattedDate}>{formattedDate}</time>
          {formattedUpdatedDate && formattedUpdatedDate !== formattedDate && (
            <span class="text-[11px] opacity-75">（更新于 {formattedUpdatedDate}）</span>
          )}
        </div>

        {readTime && (
          <div class="flex items-center gap-1.5">
            <Clock class="h-3.5 w-3.5" />
            <span>{readTime}</span>
          </div>
        )}

        {currentTopic && (
          <div class="flex items-center gap-1">
            <Layers class="h-3.5 w-3.5 text-accent" />
            <a href={`/topic/${currentTopic.slug}/`} class="text-accent hover:underline">
              {currentTopic.name}
            </a>
          </div>
        )}

        {tags.length > 0 && (
          <div class="flex items-center gap-1.5 flex-wrap">
            <Tag class="h-3.5 w-3.5" />
            {tags.map((tag) => (
              <span class="rounded bg-surface px-2 py-0.5 text-muted hover:text-fg">
                {tag}
              </span>
            ))}
          </div>
        )}

        {refLink && (
          <div class="flex items-center gap-1">
            <a
              href={refLink.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-1 text-accent hover:underline font-sans"
            >
              <span>{refLink.text}</span>
              <ExternalLink class="h-3 w-3" />
            </a>
          </div>
        )}
      </div>
    </header>

    <!-- Mobile Collapsible TOC (< 1024px) -->
    {headings.filter((h) => h.depth === 2 || h.depth === 3).length > 0 && (
      <details class="mobile-toc-details lg:hidden mb-8 rounded-lg border border-line bg-surface/50 p-4 transition-all">
        <summary class="flex items-center justify-between cursor-pointer font-serif text-sm font-semibold text-fg select-none list-none">
          <span class="flex items-center gap-2">
            <AlignLeft class="h-4 w-4 text-accent" />
            <span>文章目录 ({headings.filter((h) => h.depth === 2 || h.depth === 3).length} 节)</span>
          </span>
          <ChevronDown class="h-4 w-4 text-muted transition-transform duration-200 summary-chevron" />
        </summary>
        <div class="mt-4 pt-3 border-t border-line/60">
          <TableOfContents headings={headings} />
        </div>
      </details>
    )}

    <!-- Content Grid: Article Prose + Sticky TOC -->
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_260px] gap-12 xl:gap-16 items-start">
      <!-- Article Content -->
      <article class="editorial-prose max-w-none min-w-0" id="articleBody">
        {series && <SeriesBox seriesName={series.name} currentSlug={post.slug} />}
        <slot />
      </article>

      <!-- Desktop Sidebar TOC -->
      <aside class="hidden lg:block sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto">
        <TableOfContents headings={headings} />
      </aside>
    </div>

    <!-- Related Posts Section -->
    {relatedPosts.length > 0 && (
      <section class="mt-14 rounded-lg border border-line bg-surface/30 p-6" aria-label="相关技术文章推荐">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-5 pb-3 border-b border-line/60">
          <h2 class="font-serif text-base sm:text-lg font-bold text-fg flex items-center gap-2">
            <Sparkles class="h-4 w-4 text-accent" />
            <span>相关技术分析与延伸阅读</span>
          </h2>
          {currentTopic && (
            <a
              href={`/topic/${currentTopic.slug}/`}
              class="text-xs font-mono text-accent hover:underline flex items-center gap-1"
            >
              <span>查看「{currentTopic.name}」专题全集</span>
              <ArrowRight class="h-3 w-3" />
            </a>
          )}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {relatedPosts.map((relPost) => (
            <a
              href={`/post/${relPost.slug}/`}
              class="group flex flex-col justify-between rounded-md border border-line/70 bg-surface/40 p-4 transition-all hover:border-accent hover:bg-surface"
            >
              <div>
                <div class="text-[11px] font-mono text-muted mb-1.5">
                  {relPost.data.publishDate.toISOString().slice(0, 10)}
                  {relPost.data.readTime && ` · ${relPost.data.readTime}`}
                </div>
                <h3 class="font-serif text-sm font-semibold text-fg group-hover:text-accent transition-colors line-clamp-2 leading-snug mb-2">
                  {relPost.data.title}
                </h3>
                <p class="text-xs text-muted line-clamp-2 leading-relaxed">
                  {relPost.data.description}
                </p>
              </div>
              <div class="mt-3 flex items-center gap-1 text-[11px] font-mono text-accent group-hover:underline">
                <span>阅读全文</span>
                <ArrowRight class="h-3 w-3 transition-transform group-hover:translate-x-0.5" />
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Prev & Next Article Navigation -->
    <nav class="mt-12 border-t border-line pt-8" aria-label="上一篇与下一篇文章">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {prevPost ? (
          <a
            href={`/post/${prevPost.slug}/`}
            rel="prev"
            class="group flex flex-col gap-1 rounded-lg border border-line bg-surface/30 p-4 transition-all hover:border-accent hover:bg-surface/80"
          >
            <span class="flex items-center gap-1 text-xs font-mono text-muted group-hover:text-accent">
              <ArrowLeft class="h-3.5 w-3.5 transition-transform group-hover:-translate-x-0.5" />
              <span>上一篇</span>
            </span>
            <span class="font-serif text-sm font-semibold text-fg line-clamp-2">
              {prevPost.data.title}
            </span>
          </a>
        ) : <div />}

        {nextPost ? (
          <a
            href={`/post/${nextPost.slug}/`}
            rel="next"
            class="group flex flex-col gap-1 sm:items-end text-left sm:text-right rounded-lg border border-line bg-surface/30 p-4 transition-all hover:border-accent hover:bg-surface/80"
          >
            <span class="flex items-center gap-1 text-xs font-mono text-muted group-hover:text-accent">
              <span>下一篇</span>
              <ArrowRight class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
            </span>
            <span class="font-serif text-sm font-semibold text-fg line-clamp-2">
              {nextPost.data.title}
            </span>
          </a>
        ) : <div />}
      </div>
    </nav>

    <!-- Back to top button -->
    <button
      id="backToTopBtn"
      type="button"
      class="fixed bottom-6 right-6 hidden z-30 rounded-full border border-line bg-bg/90 backdrop-blur-md p-3 text-muted shadow-md hover:text-fg hover:border-accent transition-all"
      aria-label="返回顶部"
    >
      <ChevronUp class="h-5 w-5" />
    </button>
  </div>
</BaseLayout>

<script>
  // Close mobile TOC details when a link is clicked
  const mobileDetails = document.querySelector<HTMLDetailsElement>('.mobile-toc-details');
  mobileDetails?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      mobileDetails.open = false;
    });
  });

  // Add copy buttons and language badges to code blocks
  document.querySelectorAll<HTMLElement>('.editorial-prose pre').forEach((pre) => {
    const lang = pre.getAttribute('data-language') || '';
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block-wrapper my-6 relative group';
    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    const actionsBar = document.createElement('div');
    actionsBar.className = 'absolute top-2.5 right-3 flex items-center gap-2 z-10';

    if (lang && lang !== 'text') {
      const badge = document.createElement('span');
      badge.className = 'code-action-badge';
      badge.innerText = lang;
      actionsBar.appendChild(badge);
    }

    const copyBtn = document.createElement('button');
    copyBtn.className = 'code-copy-btn';
    copyBtn.setAttribute('type', 'button');
    copyBtn.setAttribute('aria-label', '复制代码');
    copyBtn.innerText = '复制';

    copyBtn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.innerText || pre.innerText;
      try {
        await navigator.clipboard.writeText(code);
        copyBtn.innerText = '已复制!';
        copyBtn.classList.add('text-accent');
        setTimeout(() => {
          copyBtn.innerText = '复制';
          copyBtn.classList.remove('text-accent');
        }, 2000);
      } catch (err) {
        copyBtn.innerText = '失败';
        setTimeout(() => {
          copyBtn.innerText = '复制';
        }, 2000);
      }
    });

    actionsBar.appendChild(copyBtn);
    wrapper.appendChild(actionsBar);
  });

  // Back to top scroll button
  const bttBtn = document.getElementById('backToTopBtn');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 400) {
      bttBtn?.classList.remove('hidden');
    } else {
      bttBtn?.classList.add('hidden');
    }
  });

  bttBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
