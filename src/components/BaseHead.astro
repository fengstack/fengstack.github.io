---
import { SITE } from '../data/site';

interface Props {
  title?: string;
  cleanTitle?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  publishDate?: Date;
  updatedDate?: Date;
  articleTags?: string[];
  canonicalURL?: URL | string;
  noindex?: boolean;
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title = SITE.title,
  cleanTitle,
  description = SITE.description,
  image = SITE.defaultImage,
  type = 'website',
  publishDate,
  updatedDate,
  articleTags = [],
  canonicalURL,
  noindex = false,
  breadcrumbs,
} = Astro.props;

const siteBase = Astro.site || SITE.url;
const siteOrigin = `${SITE.url.replace(/\/$/, '')}/`;
const rawCanonical = canonicalURL ? canonicalURL.toString() : new URL(Astro.url.pathname, siteBase).toString();
const canonicalObj = new URL(rawCanonical, siteBase);
const hasExt = /\.[a-zA-Z0-9]+$/.test(canonicalObj.pathname);
const finalCanonical = canonicalObj.pathname.endsWith('/') || hasExt
  ? canonicalObj.toString()
  : `${canonicalObj.origin}${canonicalObj.pathname}/${canonicalObj.search}${canonicalObj.hash}`;

const siteTitle = title.includes(SITE.name) ? title : `${title} · ${SITE.siteName}`;
const fullImageURL = new URL(image, siteBase).toString();
const logoImageURL = new URL(SITE.logoImage, siteBase).toString();
const finalModifiedDate = updatedDate || publishDate;
const headline =
  cleanTitle ||
  title
    .replace(` · ${SITE.siteName}`, '')
    .replace(SITE.title.replace(SITE.name, ''), '');
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="alternate" type="application/rss+xml" title={SITE.rssTitle} href={SITE.rssPath} />

<!-- Canonical URL -->
{!noindex && <link rel="canonical" href={finalCanonical} />}

<!-- Primary Meta Tags -->
<title>{siteTitle}</title>
<meta name="title" content={siteTitle} />
<meta name="description" content={description} />
<meta name="author" content={SITE.name} />
<meta name="keywords" content={articleTags.length > 0 ? articleTags.join(', ') : `软件工程师, ${SITE.name}, 技术博客, AI 编程, Java, Go, RPC, Netty, jOOQ, PostGIS, SDD, TDD, Code Review`} />
{noindex ? (
  <meta name="robots" content="noindex, follow" />
) : (
  <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
)}

<!-- Search Engine Verification Tags -->
<meta name="msvalidate.01" content="C881F074467FD6757DFB5E6C8EE1B7DB" />

<!-- Theme color -->
<meta name="theme-color" content="#FAF9F6" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#141413" media="(prefers-color-scheme: dark)" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={finalCanonical} />
<meta property="og:site_name" content={SITE.siteName} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageURL} />
<meta property="og:locale" content="zh_CN" />

{type === 'article' && publishDate && (
  <meta property="article:published_time" content={publishDate.toISOString()} />
)}
{type === 'article' && finalModifiedDate && (
  <meta property="article:modified_time" content={finalModifiedDate.toISOString()} />
)}
{articleTags.map(tag => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter -->
<meta name="twitter:card" content="summary" />
<meta name="twitter:url" content={finalCanonical} />
<meta name="twitter:title" content={siteTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageURL} />

<!-- Structured Data: BreadcrumbList (JSON-LD) -->
{!noindex && breadcrumbs && breadcrumbs.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbs.map((crumb, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": crumb.name,
      "item": crumb.url.startsWith('http') ? crumb.url : new URL(crumb.url, siteBase).toString()
    }))
  })} />
)}

<!-- Structured Data: Article / Person / WebSite (JSON-LD) -->
{!noindex && (type === 'article' ? (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": headline,
    "description": description,
    "image": fullImageURL,
    "keywords": articleTags.length > 0 ? articleTags.join(', ') : undefined,
    "url": finalCanonical,
    "datePublished": publishDate ? publishDate.toISOString().slice(0, 10) : undefined,
    "dateModified": finalModifiedDate ? finalModifiedDate.toISOString().slice(0, 10) : undefined,
    "inLanguage": "zh-CN",
    "author": {
      "@type": "Person",
      "name": SITE.name,
      "url": siteOrigin
    },
    "publisher": {
      "@type": "Person",
      "name": SITE.name,
      "url": siteOrigin,
      "image": logoImageURL
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": finalCanonical
    }
  })} />
) : (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": `${siteOrigin}#person`,
        "name": SITE.name,
        "alternateName": SITE.alternateNames,
        "url": siteOrigin,
        "email": `mailto:${SITE.email}`,
        "jobTitle": "软件工程师",
        "description": `${SITE.name}，软件工程师，开源项目 small-rpc、jooq-postgis 作者，关注分布式 RPC、开源数据库与 AI 工程化。`,
        "sameAs": [
          SITE.githubUrl,
          SITE.altGithubUrl
        ],
        "knowsAbout": ["Java", "RPC", "Netty", "jOOQ", "PostGIS", "Go", "Python", "TypeScript", "AI Agent", "SDD", "TDD"]
      },
      {
        "@type": "WebSite",
        "@id": `${siteOrigin}#website`,
        "name": SITE.siteName,
        "alternateName": SITE.alternateSiteName,
        "url": siteOrigin,
        "inLanguage": "zh-CN",
        "author": { "@id": `${siteOrigin}#person` }
      }
    ]
  })} />
))}

<!-- Prevent Dark Mode Flicker (FOUC) -->
<script is:inline>
  (function () {
    const stored = localStorage.getItem('gw-theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const theme = stored || (prefersDark ? 'dark' : 'light');
    if (theme === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
    } else {
      document.documentElement.setAttribute('data-theme', 'light');
    }
  })();
</script>
