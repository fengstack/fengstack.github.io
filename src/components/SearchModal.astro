---
import { Search, X } from 'lucide-astro';
---

<div
  id="searchModal"
  class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm p-4 sm:p-6 md:p-20 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="searchModalTitle"
>
  <div class="mx-auto max-w-2xl transform rounded-lg border border-line bg-bg shadow-2xl transition-all">
    <h2 id="searchModalTitle" class="sr-only">站内文章搜索</h2>
    <!-- Search Input Area -->
    <div class="relative flex items-center border-b border-line px-4 py-3">
      <Search class="h-5 w-5 text-muted shrink-0" />
      <input
        id="modalSearchInput"
        type="search"
        placeholder="搜索文章标题、摘要、标签或关键字…"
        class="w-full bg-transparent px-3 py-1.5 text-base text-fg placeholder:text-muted focus:outline-none"
        autocomplete="off"
        spellcheck="false"
      />
      <button
        id="searchModalClose"
        type="button"
        class="rounded p-1 text-muted hover:text-fg hover:bg-surface transition-colors"
        aria-label="关闭搜索"
      >
        <X class="h-5 w-5" />
      </button>
    </div>

    <!-- Search Results / Empty State -->
    <div id="searchResults" class="max-h-[60vh] overflow-y-auto p-3 divide-y divide-line/60">
      <div id="searchPlaceholder" class="py-12 text-center text-sm text-muted">
        输入关键字搜索博文… 支持标题、摘要及分类标签
      </div>
      <div id="searchLoading" class="hidden py-12 text-center text-sm text-muted">
        正在加载搜索索引…
      </div>
      <div id="searchEmpty" class="hidden py-12 text-center text-sm text-muted">
        未找到包含该关键字的技术文章
      </div>
      <div id="searchError" class="hidden py-12 text-center text-sm text-red-600 dark:text-red-400">
        搜索索引加载失败，请稍后重试
      </div>
      <div id="resultsList" class="flex flex-col gap-1"></div>
    </div>

    <!-- Footer Guide -->
    <div class="flex items-center justify-between border-t border-line bg-surface/50 px-4 py-2 text-xs text-muted">
      <span>支持上下方向键导航，回车进入</span>
      <div class="flex items-center gap-2">
        <kbd class="rounded border border-line bg-bg px-1.5 py-0.5 font-mono text-[10px]">ESC</kbd>
        <span>关闭</span>
      </div>
    </div>
  </div>
</div>

<script>
  interface SearchItem {
    slug: string;
    title: string;
    description: string;
    date: string;
    tags: string[];
    readTime?: string;
    series?: string;
  }

  let searchIndex: SearchItem[] = [];
  let isIndexLoaded = false;
  let isIndexFailed = false;
  let loadPromise: Promise<void> | null = null;
  let selectedIndex = -1;
  let lastFocusedElement: HTMLElement | null = null;

  const modal = document.getElementById('searchModal');
  const input = document.getElementById('modalSearchInput') as HTMLInputElement | null;
  const triggerBtn = document.getElementById('searchTriggerBtn');
  const closeBtn = document.getElementById('searchModalClose');
  const resultsList = document.getElementById('resultsList');
  const searchPlaceholder = document.getElementById('searchPlaceholder');
  const searchLoading = document.getElementById('searchLoading');
  const searchEmpty = document.getElementById('searchEmpty');
  const searchError = document.getElementById('searchError');

  function showErrorState() {
    if (resultsList) resultsList.replaceChildren();
    selectedIndex = -1;
    searchPlaceholder?.classList.add('hidden');
    searchLoading?.classList.add('hidden');
    searchEmpty?.classList.add('hidden');
    searchError?.classList.remove('hidden');
  }

  function showLoadingState() {
    if (resultsList) resultsList.replaceChildren();
    selectedIndex = -1;
    searchPlaceholder?.classList.add('hidden');
    searchEmpty?.classList.add('hidden');
    searchError?.classList.add('hidden');
    searchLoading?.classList.remove('hidden');
  }

  async function loadSearchIndex(): Promise<void> {
    if (isIndexLoaded) return;
    if (loadPromise) return loadPromise;

    isIndexFailed = false;
    searchError?.classList.add('hidden');

    loadPromise = (async () => {
      try {
        const res = await fetch('/api/search.json');
        if (!res.ok) {
          throw new Error(`HTTP ${res.status}`);
        }
        searchIndex = await res.json();
        isIndexLoaded = true;
        isIndexFailed = false;
        if (input?.value.trim()) {
          filterAndRender();
        }
      } catch (e) {
        isIndexFailed = true;
        console.error('Failed to load search index', e);
        showErrorState();
      } finally {
        loadPromise = null;
      }
    })();

    return loadPromise;
  }

  function openModal() {
    lastFocusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    modal?.classList.remove('hidden');
    loadSearchIndex();
    setTimeout(() => input?.focus(), 50);
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal?.classList.add('hidden');
    if (input) input.value = '';
    searchError?.classList.add('hidden');
    searchLoading?.classList.add('hidden');
    renderResults([], []);
    document.body.style.overflow = '';
    if (lastFocusedElement && document.contains(lastFocusedElement) && lastFocusedElement !== document.body) {
      lastFocusedElement.focus();
    }
    lastFocusedElement = null;
  }

  triggerBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);

  // Close when clicking backdrop
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // Focus trap inside modal dialog
  modal?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || modal.classList.contains('hidden')) return;
    const focusables = Array.from(
      modal.querySelectorAll<HTMLElement>(
        'input:not([disabled]), button:not([disabled]), a[href]'
      )
    ).filter((el) => el.offsetParent !== null);

    if (focusables.length === 0) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];

    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Global shortcut (Cmd+K / Ctrl+K / Escape)
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (modal?.classList.contains('hidden')) {
        openModal();
      } else {
        closeModal();
      }
    } else if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
      closeModal();
    }
  });

  function appendHighlightedText(parent: HTMLElement, text: string, tokens: string[]) {
    if (!tokens.length || !text) {
      parent.textContent = text;
      return;
    }
    const uniqueTokens = Array.from(new Set(tokens)).sort((a, b) => b.length - a.length);
    const escaped = uniqueTokens.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
    const regex = new RegExp(`(${escaped.join('|')})`, 'gi');

    let lastIdx = 0;
    let match: RegExpExecArray | null;
    while ((match = regex.exec(text)) !== null) {
      if (match.index > lastIdx) {
        parent.appendChild(document.createTextNode(text.slice(lastIdx, match.index)));
      }
      const mark = document.createElement('mark');
      mark.className = 'rounded-sm bg-accent/20 text-accent px-0.5 font-semibold';
      mark.textContent = match[0];
      parent.appendChild(mark);
      lastIdx = regex.lastIndex;
    }
    if (lastIdx < text.length) {
      parent.appendChild(document.createTextNode(text.slice(lastIdx)));
    }
  }

  function renderResults(items: SearchItem[], tokens: string[]) {
    if (!resultsList || !searchPlaceholder || !searchEmpty) return;
    resultsList.replaceChildren();
    selectedIndex = -1;
    searchLoading?.classList.add('hidden');
    searchError?.classList.add('hidden');

    if (!input?.value.trim()) {
      searchPlaceholder.classList.remove('hidden');
      searchEmpty.classList.add('hidden');
      return;
    }

    searchPlaceholder.classList.add('hidden');

    if (items.length === 0) {
      searchEmpty.classList.remove('hidden');
      return;
    }

    searchEmpty.classList.add('hidden');

    items.forEach((item, idx) => {
      const a = document.createElement('a');
      a.href = `/post/${item.slug}/`;
      a.className =
        'search-result-item flex flex-col gap-1 rounded-md p-3 text-left transition-colors hover:bg-surface focus:bg-surface outline-none';
      a.dataset.index = String(idx);

      const titleEl = document.createElement('div');
      titleEl.className = 'font-serif font-semibold text-fg text-sm';
      appendHighlightedText(titleEl, item.title, tokens);

      const descEl = document.createElement('div');
      descEl.className = 'line-clamp-2 text-xs text-muted leading-relaxed';
      appendHighlightedText(descEl, item.description, tokens);

      const metaEl = document.createElement('div');
      metaEl.className = 'mt-1 flex flex-wrap items-center gap-3 text-[11px] text-muted font-mono';

      const dateEl = document.createElement('span');
      dateEl.textContent = item.date;
      metaEl.appendChild(dateEl);

      if (item.readTime) {
        const readTimeEl = document.createElement('span');
        readTimeEl.textContent = `· ${item.readTime}`;
        metaEl.appendChild(readTimeEl);
      }

      if (item.series) {
        const seriesEl = document.createElement('span');
        seriesEl.className = 'rounded bg-accent/10 px-1.5 py-0.5 font-sans text-[11px] text-accent';
        appendHighlightedText(seriesEl, item.series, tokens);
        metaEl.appendChild(seriesEl);
      }

      const tagsEl = document.createElement('div');
      tagsEl.className = 'flex flex-wrap items-center gap-1';
      item.tags.forEach((tag) => {
        const tagSpan = document.createElement('span');
        tagSpan.className = 'rounded bg-tag-bg px-1.5 py-0.5 text-[11px] text-tag-fg';
        appendHighlightedText(tagSpan, tag, tokens);
        tagsEl.appendChild(tagSpan);
      });
      metaEl.appendChild(tagsEl);

      a.append(titleEl, descEl, metaEl);
      resultsList.appendChild(a);
    });
  }

  function scoreSearchItem(item: SearchItem, fullQuery: string, tokens: string[]): number {
    const titleLower = item.title.toLowerCase();
    const descLower = item.description.toLowerCase();
    const seriesLower = (item.series || '').toLowerCase();
    const tagsLower = item.tags.map((t) => t.toLowerCase());

    let totalScore = 0;

    for (const token of tokens) {
      let tokenScore = 0;
      if (titleLower.includes(token)) tokenScore += 8;
      if (tagsLower.some((t) => t.includes(token))) tokenScore += 6;
      if (seriesLower.includes(token)) tokenScore += 5;
      if (descLower.includes(token)) tokenScore += 2;

      if (tokenScore === 0) return 0;
      totalScore += tokenScore;
    }

    if (titleLower.includes(fullQuery)) {
      totalScore += titleLower.startsWith(fullQuery) ? 16 : 12;
    } else if (tagsLower.some((t) => t === fullQuery)) {
      totalScore += 10;
    }

    return totalScore;
  }

  function filterAndRender() {
    const raw = input?.value.trim().toLowerCase() || '';
    const tokens = raw.split(/\s+/).filter(Boolean);
    if (!raw || tokens.length === 0) {
      if (isIndexFailed) {
        showErrorState();
      } else {
        renderResults([], []);
      }
      return;
    }

    if (isIndexFailed) {
      showErrorState();
      return;
    }

    if (!isIndexLoaded) {
      showLoadingState();
      loadSearchIndex();
      return;
    }

    const matched = searchIndex
      .map((item) => ({ item, score: scoreSearchItem(item, raw, tokens) }))
      .filter((entry) => entry.score > 0)
      .sort((a, b) => b.score - a.score)
      .map((entry) => entry.item);

    renderResults(matched, tokens);
  }

  // Input filter
  input?.addEventListener('input', filterAndRender);

  // Keyboard navigation within list
  input?.addEventListener('keydown', (e) => {
    const items = resultsList?.querySelectorAll('.search-result-item');
    if (!items || items.length === 0) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      selectedIndex = (selectedIndex + 1) % items.length;
      updateSelection(items);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      selectedIndex = (selectedIndex - 1 + items.length) % items.length;
      updateSelection(items);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (selectedIndex >= 0 && items[selectedIndex]) {
        (items[selectedIndex] as HTMLAnchorElement).click();
      } else if (items.length > 0) {
        (items[0] as HTMLAnchorElement).click();
      }
    }
  });

  function updateSelection(items: NodeListOf<Element>) {
    items.forEach((it, idx) => {
      if (idx === selectedIndex) {
        it.classList.add('bg-surface');
        it.scrollIntoView({ block: 'nearest' });
      } else {
        it.classList.remove('bg-surface');
      }
    });
  }
</script>
