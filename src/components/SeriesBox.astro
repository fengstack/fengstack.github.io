---
import { getCollection } from 'astro:content';
import { Layers } from 'lucide-astro';

interface Props {
  seriesName: string;
  currentSlug: string;
}

const { seriesName, currentSlug } = Astro.props;

const allPosts = await getCollection('posts');
const seriesPosts = allPosts
  .filter((p) => p.data.series?.name === seriesName)
  .sort((a, b) => (a.data.series?.order || 0) - (b.data.series?.order || 0));
---

{seriesPosts.length > 1 && (
  <aside class="my-8 rounded-lg border border-accent/20 bg-surface/60 p-5 text-sm" aria-label="系列文章">
    <div class="flex items-center gap-2 font-mono text-xs font-semibold tracking-wider text-accent uppercase">
      <Layers class="h-4 w-4" />
      <span>系列专题 · {seriesName}</span>
    </div>
    <ol class="mt-3 flex flex-col gap-2 pl-4 list-decimal text-muted">
      {seriesPosts.map((post) => {
        const isCurrent = post.slug === currentSlug;
        return (
          <li class={isCurrent ? 'font-semibold text-fg marker:text-accent' : ''}>
            {isCurrent ? (
              <span class="text-fg">{post.data.title} <span class="text-xs font-mono text-accent">（当前篇）</span></span>
            ) : (
              <a
                href={`/post/${post.slug}/`}
                class="hover:text-accent transition-colors underline-offset-2 hover:underline"
              >
                {post.data.title}
              </a>
            )}
          </li>
        );
      })}
    </ol>
  </aside>
)}
