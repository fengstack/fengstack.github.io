---
import { SITE } from '../data/site';

const currentYear = new Date().getFullYear();
const githubHostPath = SITE.githubUrl.replace(/^https?:\/\//, '');
---

<footer class="mt-auto border-t border-line bg-surface/40 py-8 text-sm text-muted">
  <div class="wrap-container flex flex-col items-center justify-between gap-4 sm:flex-row">
    <div class="flex items-center gap-2">
      <span>© {currentYear} · {SITE.name}</span>
      <span class="text-line">|</span>
      <span class="text-xs">软件工程师</span>
    </div>

    <div class="flex flex-wrap items-center gap-3 sm:gap-4 text-xs font-mono">
      <a
        href={SITE.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-fg transition-colors"
      >
        {githubHostPath}
      </a>
      <span class="text-line">/</span>
      <a
        href="/topic/"
        class="hover:text-fg transition-colors"
      >
        技术专题
      </a>
      <span class="text-line">/</span>
      <a
        href={SITE.rssPath}
        class="hover:text-fg transition-colors"
        title="RSS 2.0 订阅源"
      >
        RSS 订阅
      </a>
      <span class="text-line">/</span>
      <a
        href="/sitemap.xml"
        class="hover:text-fg transition-colors"
        title="XML 站点地图"
      >
        Sitemap
      </a>
      <span class="text-line">/</span>
      <a
        href={`mailto:${SITE.email}`}
        class="hover:text-fg transition-colors"
      >
        联系邮箱
      </a>
    </div>
  </div>
</footer>
