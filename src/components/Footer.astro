---
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-line bg-surface/40 py-8 text-sm text-muted">
  <div class="wrap-container flex flex-col items-center justify-between gap-4 sm:flex-row">
    <div class="flex items-center gap-2">
      <span>© {currentYear} · 高云峰</span>
      <span class="text-line">|</span>
      <span class="text-xs">软件工程师</span>
    </div>

    <div class="flex items-center gap-4 text-xs font-mono">
      <a
        href="https://github.com/fengstack"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-fg transition-colors"
      >
        github.com/fengstack
      </a>
      <span class="text-line">/</span>
      <a
        href="/post/index.xml"
        class="hover:text-fg transition-colors"
        title="RSS 2.0 订阅源"
      >
        RSS 订阅
      </a>
      <span class="text-line">/</span>
      <a
        href="mailto:gyf718@hotmail.com"
        class="hover:text-fg transition-colors"
      >
        联系邮箱
      </a>
    </div>
  </div>
</footer>
